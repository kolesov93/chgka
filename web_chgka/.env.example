# Production runtime example. Copy values into the deployment secret/config
# mechanism; the application does not load this file automatically.
CHGKA_ENV=production
QUESTIONS_PACK_PATH=/data/questions
ADMIN_PASSWORD=replace-with-a-secret-of-at-least-12-characters
ALLOWED_ORIGINS=https://chgka.example.com
ADMIN_TOKEN_TTL_SECONDS=43200
