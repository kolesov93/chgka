# Copy to ~/apps/chgka/.env.production, replace the password, and chmod 600.
# The application never loads this repository example automatically.
COMPOSE_PROJECT_NAME=chgka
CHGKA_IMAGE_TAG=replace-with-git-commit
CHGKA_BIND_ADDRESS=127.0.0.1
CHGKA_HTTP_PORT=18080
CHGKA_QUESTIONS_PATH=/home/kolesov93/apps/chgka/questions/current
CHGKA_DATA_PATH=/home/kolesov93/apps/chgka/data
CHGKA_BACKUPS_PATH=/home/kolesov93/apps/chgka/backups
ALLOWED_ORIGINS=https://example.com
ADMIN_TOKEN_TTL_SECONDS=43200
ADMIN_PASSWORD=replace-with-a-secret-of-at-least-12-characters
